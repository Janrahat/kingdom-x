# KINGDOM X — example configuration
#
# Copy to .env and fill in only what you actually have.
# NEVER commit the real .env. It is already in .gitignore.
#
#   cp .env.example .env
#   chmod 600 .env

# ------------------------------------------------------------------ AI providers
# A provider is only reported as AVAILABLE after a real health check succeeds.
# Leave a key blank and that provider stays UNKNOWN — that is the honest state.

# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...
# DEEPSEEK_API_KEY=...
# MISTRAL_API_KEY=...
# QWEN_API_KEY=...
# GROQ_API_KEY=...
# OpenRouter is supported through the OpenAI-compatible API. Prefer the encrypted
# local vault: python kingdomx.py ai set-key openrouter
# Or export OPENROUTER_API_KEY in the shell for the current session.
# OPENROUTER_API_KEY=...
# HUGGINGFACE_API_KEY=hf_...

# Local models — no key needed. Point at your own daemon.
# OLLAMA_HOST=http://127.0.0.1:11434
# CUSTOM_AI_BASE_URL=https://your-endpoint.example.com/v1
# CUSTOM_AI_API_KEY=...

# ------------------------------------------------------------------- behaviour
# KINGDOMX_AI_PROVIDER=openai
# KINGDOMX_AI_MODEL=gpt-4o-mini
# KINGDOMX_TIMEOUT=15
# KINGDOMX_LOG_LEVEL=INFO

# ---------------------------------------------------------------- web dashboard
# Bind to 127.0.0.1 unless you have a reverse proxy with TLS in front of it.
# KINGDOMX_WEB_HOST=127.0.0.1
# KINGDOMX_WEB_PORT=8000

# ------------------------------------------------------------ network safety
# Active scans are refused unless the operator records authorization.
# KINGDOMX_ALLOW_PRIVATE_TARGETS=false
